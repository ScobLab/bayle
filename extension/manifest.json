{
  "manifest_version": 3,
  "name": "Bayle",
  "version": "1.0.0",
  "description": "Analyseur de biais médiatiques. Extrait et analyse automatiquement l'article que vous lisez.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Analyser avec Bayle"
  },
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://api.mistral.ai/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["readability.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
